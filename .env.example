# -----------------------------------------------------------------------------
# Menus.ps — Environment Variables Configuration
# -----------------------------------------------------------------------------

# Supabase Public API (Accessible on Client and Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role (Server-Only, bypasses RLS - Keep Secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct Database Connection (Port 5432 - Used for Migrations and Local Admin Only)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# High-Traffic Connection Pooler (Port 6543 - Transaction Mode - Supavisor / PgBouncer)
# MANDATORY FOR ALL SERVERLESS / EDGE RUNTIMES TO PREVENT CONNECTION EXHAUSTION
DATABASE_POOLER_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Public Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
